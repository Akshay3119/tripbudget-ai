[
  {
    "id": "select-NYC",
    "task": "supervisor",
    "schema": {
      "$defs": {
        "CityActivities": {
          "additionalProperties": false,
          "properties": {
            "NYC": {
              "description": "Rank every supplied ID once. These are candidates; activities_per_day controls scheduling.",
              "items": {
                "enum": [
                  "nyc-met",
                  "nyc-central-park",
                  "nyc-high-line",
                  "nyc-ferry"
                ],
                "type": "string"
              },
              "maxItems": 4,
              "minItems": 4,
              "title": "Nyc",
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "NYC"
          ],
          "title": "CityActivities",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "lodging_tier": {
          "default": "standard",
          "enum": [
            "standard",
            "economy"
          ],
          "title": "Lodging Tier",
          "type": "string"
        },
        "activities_per_day": {
          "default": 2,
          "enum": [
            1,
            2
          ],
          "title": "Activities Per Day",
          "type": "integer"
        },
        "activities": {
          "$ref": "#/$defs/CityActivities"
        },
        "explanation": {
          "maxLength": 1800,
          "title": "Explanation",
          "type": "string"
        },
        "expected_cost_cents": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected GROUP total in integer USD cents, including contingency",
          "title": "Expected Cost Cents"
        }
      },
      "required": [
        "activities",
        "explanation"
      ],
      "title": "ContextualPlanChoice",
      "type": "object"
    },
    "payload": {
      "instruction": "Select economy lodging, one activity per day, and include all supplied IDs under the exact city code.",
      "constraints": {
        "cities": [
          "NYC"
        ]
      },
      "catalog": [
        {
          "id": "nyc-met",
          "city": "NYC",
          "title": "Metropolitan Museum of Art",
          "category": "museum",
          "price_cents": 3000,
          "duration_minutes": 120,
          "walk_meters": 1800,
          "closed_weekdays": [
            2
          ]
        },
        {
          "id": "nyc-central-park",
          "city": "NYC",
          "title": "Central Park walk",
          "category": "park",
          "price_cents": 0,
          "duration_minutes": 90,
          "walk_meters": 2400,
          "closed_weekdays": []
        },
        {
          "id": "nyc-high-line",
          "city": "NYC",
          "title": "High Line gardens",
          "category": "park",
          "price_cents": 0,
          "duration_minutes": 60,
          "walk_meters": 1800,
          "closed_weekdays": []
        },
        {
          "id": "nyc-ferry",
          "city": "NYC",
          "title": "Staten Island Ferry round trip",
          "category": "viewpoint",
          "price_cents": 0,
          "duration_minutes": 90,
          "walk_meters": 800,
          "closed_weekdays": []
        }
      ]
    },
    "oracle": {
      "city": "NYC",
      "ids": [
        "nyc-met",
        "nyc-central-park",
        "nyc-high-line",
        "nyc-ferry"
      ]
    }
  },
  {
    "id": "query-NYC",
    "task": "query_rewrite",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Query",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "query",
        "reason"
      ],
      "title": "QueryRewrite",
      "type": "object"
    },
    "payload": {
      "instruction": "Rewrite a public query for admission prices and opening hours. Include city code.",
      "city": "NYC",
      "query": "NYC group cultural activities"
    },
    "oracle": {
      "city": "NYC"
    }
  },
