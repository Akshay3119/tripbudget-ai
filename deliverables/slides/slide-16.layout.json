{"id":"sh/4butwf65","kind":"textbox","position":{"left":420,"top":327,"width":786,"height":112},"text":"Improve constrained local output quality and public fallback context packing. Add HA PostgreSQL, restore drills, enterprise identity/RLS and sustained multi-user load evaluation.","style":{"fontSize":26,"typeface":"Arial","color":"#365148","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/pc3a5k7q","kind":"textbox","position":{"left":68,"top":472,"width":328,"height":110},"text":"Deeper evaluation","style":{"fontSize":29,"typeface":"Arial","color":"#123D34","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/29cbu5oz","kind":"textbox","position":{"left":420,"top":472,"width":786,"height":112},"text":"More independent prompts and repeats; blind holdouts; task-specific verbal-compliance adjudication and measured invoices. Student reviews process log and gives graders artifact/repository access.","style":{"fontSize":26,"typeface":"Arial","color":"#365148","alignment":"left"},"geometry":"rect","lineWidth":0},
