{"id":"sh/u5srqlo3","kind":"textbox","position":{"left":420,"top":182,"width":786,"height":112},"text":"Add approved source-refresh workflows, transport DNS pinning and broader holiday/accessibility validation. Real prices and ticket availability can differ from estimates.","style":{"fontSize":26,"typeface":"Arial","color":"#365148","alignment":"left"},"geometry":"rect","lineWidth":0},
