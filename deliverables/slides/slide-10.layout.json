{"id":"sh/2hwrqtwz","kind":"textbox","position":{"left":68,"top":182,"width":328,"height":110},"text":"Money, evidence and schedule","style":{"fontSize":29,"typeface":"Arial","color":"#123D34","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/0nep03ux","kind":"textbox","position":{"left":420,"top":182,"width":786,"height":112},"text":"Strict schemas, catalog IDs, source digest/expiry, all-in estimates, exact-cent allocations, room/night/meal coverage, caps and time/walk checks.","style":{"fontSize":26,"typeface":"Arial","color":"#365148","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/lo769obi","kind":"textbox","position":{"left":68,"top":327,"width":328,"height":110},"text":"Authority and capabilities","style":{"fontSize":29,"typeface":"Arial","color":"#123D34","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/ylw7ytcr","kind":"textbox","position":{"left":420,"top":327,"width":786,"height":112},"text":"Owner checks, hashed sessions, hash-bound decisions and one-ledger uniqueness. Agent tools are read-only: no arbitrary shell, email, payment or booking.","style":{"fontSize":26,"typeface":"Arial","color":"#365148","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/zm5o7ytc","kind":"textbox","position":{"left":68,"top":472,"width":328,"height":110},"text":"Bounded damage and honest risk","style":{"fontSize":29,"typeface":"Arial","color":"#123D34","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/cjepwju1","kind":"textbox","position":{"left":420,"top":472,"width":786,"height":112},"text":"Persisted call/token/time quotas and two repairs. Residual risks: compromised sessions/providers/publishers, advisory verbal compliance and DNS validation/connection gap.","style":{"fontSize":26,"typeface":"Arial","color":"#365148","alignment":"left"},"geometry":"rect","lineWidth":0},
